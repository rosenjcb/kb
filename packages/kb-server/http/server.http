# kb server — HTTP collection + integration tests (httpyac)
#
# These requests double as examples and as the integration suite. Each has
# httpyac test/assert blocks that check response *structure* (status, shape),
# not specific content, so they're stable across knowledge bases.
#
# Run as examples (VS Code httpyac extension or CLI):
#   httpyac send http/server.http -n query --env local
#
# Run as the integration suite (spins up Docker, runs all, tears down):
#   pnpm run integration:test
#
# Environments: `http/.httpyac.js` + `http/http-client.env.json` ({{baseUrl}}, {{apiKey}}).
# `http/package.json` sets `"type": "commonjs"` so httpyac can load the config in this ESM repo.
# Post-response scripts must `require('assert')` inside the `{{ }}` block (httpyac does not inject it).

# ---------------------------------------------------------------------------
# Health (unauthenticated)
# ---------------------------------------------------------------------------
# @name health
GET {{baseUrl}}/healthz

{{
  const assert = require('assert');
  test('[smoke] status 200', () => assert.strictEqual(response.statusCode, 200));
  test('[TC-1] health shape', () => {
    const body = response.parsedBody;
    assert.strictEqual(body.ok, true);
    assert.strictEqual(typeof body.base, 'string');
    assert.ok(body.base.length > 0);
    // indexMtime is ISO mtime of .kb-index.sqlite (last init/scan/reindex write)
    assert.strictEqual(typeof body.indexMtime, 'string');
    assert.ok(!Number.isNaN(Date.parse(body.indexMtime)));
    assert.ok(body.version && typeof body.version === 'object');
    assert.strictEqual(typeof body.version.server, 'string');
    assert.strictEqual(body.version.core, undefined);
    assert.ok(/^\d+\.\d+\.\d+/.test(body.version.server), `server version: ${body.version.server}`);
  });
}}

###

# ---------------------------------------------------------------------------
# Query — synthesized answer + sources (the Slack / app shape)
# ---------------------------------------------------------------------------
# @name query
POST {{baseUrl}}/v1/query
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "q": "What is dataform? How does it work with the reporting layer? How does the main fintary repo interact with bigquery?"
}

{{
  const assert = require('assert');
  test('[smoke] status 200', () => assert.strictEqual(response.statusCode, 200));
  test('[TC-3] query result shape', () => {
    const b = response.parsedBody;
    assert.strictEqual(typeof b.status, 'string');
    assert.ok('answer' in b);
    assert.ok(Array.isArray(b.sources));
    // Lean default: no fact dump or retrieval telemetry.
    assert.strictEqual(b.results, undefined);
    assert.strictEqual(b.retrieval, undefined);
  });
}}

###

# Query — facts only (no LLM synthesis), full evidence via verbose
# @name queryFactsOnly
POST {{baseUrl}}/v1/query
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "q": "rate limiting",
  "synthesize": false,
  "verbose": true,
  "limit": 10,
  "discovery": "deep"
}

{{
  const assert = require('assert');
  test('[smoke] status 200', () => assert.strictEqual(response.statusCode, 200));
  test('[TC-4] results is an array', () => assert.ok(Array.isArray(response.parsedBody.results)));
}}

