# ---------------------------------------------------------------------------
# Query — auth is enforced (missing key → 401)
# ---------------------------------------------------------------------------
# @name queryUnauthorized
POST {{baseUrl}}/v1/query
Content-Type: application/json

{
  "q": "anything"
}

{{
  const assert = require('assert');
  test('[TC-5] status 401 without key', () => assert.strictEqual(response.statusCode, 401));
}}

###

# ---------------------------------------------------------------------------
# Chat — multi-turn, streamed over SSE.
# Reuse the same sessionId across requests to keep conversation history.
# ---------------------------------------------------------------------------
# @name chat
POST {{baseUrl}}/v1/chat
Authorization: Bearer {{apiKey}}
Content-Type: application/json
Accept: text/event-stream

{
  "sessionId": "demo-session",
  "message": "how does authentication work?"
}

{{
  const assert = require('assert');
  test('[smoke] status 200', () => assert.strictEqual(response.statusCode, 200));
  test('[TC-6] sse content type', () =>
    assert.ok(String(response.contentType?.mimeType || '').includes('text/event-stream')));
  test('[TC-7] sse stream has session + terminal events', () => {
    const body = response.body || '';
    assert.ok(body.includes('event: session'));
    assert.ok(body.includes('event: answer'));
    assert.ok(body.includes('event: done'));
  });
}}

###

# Chat — follow-up on the same session (exercises conversation memory)
# @name chatFollowUp
POST {{baseUrl}}/v1/chat
Authorization: Bearer {{apiKey}}
Content-Type: application/json
Accept: text/event-stream

{
  "sessionId": "demo-session",
  "message": "and how are those tokens refreshed?"
}

{{
  const assert = require('assert');
  test('[smoke] status 200', () => assert.strictEqual(response.statusCode, 200));
  test('[TC-8] answered', () => assert.ok((response.body || '').includes('event: done')));
}}

###

# ---------------------------------------------------------------------------
# MCP (Streamable HTTP) — requires `kb-server start --with-mcp` (Docker CMD uses this).
# JSON-RPC 2.0; stateful sessions (mcp-session-id) so elicitation can round-trip.
# ---------------------------------------------------------------------------
# @name mcpInitialize
POST {{baseUrl}}/mcp
Authorization: Bearer {{apiKey}}
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 1,
  "method": "initialize",
  "params": {
    "protocolVersion": "2025-06-18",
    "capabilities": {},
    "clientInfo": { "name": "httpyac", "version": "1.0" }
  }
}

{{
  const assert = require('assert');
  // Elicitation-on (default) returns SSE; JSON mode when KB_MCP_ELICITATION=false.
  const mcpJson = (res) => {
    if (res.parsedBody && res.parsedBody.jsonrpc) return res.parsedBody;
    const raw = typeof res.body === 'string' ? res.body : (res.rawBody || '');
    const matches = String(raw).match(/^data:\s*(.+)$/gm);
    if (matches && matches.length) {
      return JSON.parse(matches[matches.length - 1].replace(/^data:\s*/, ''));
    }
    return res.parsedBody;
  };
  test('[smoke] status 200', () => assert.strictEqual(response.statusCode, 200));
  test('[TC-9] jsonrpc result', () => {
    const body = mcpJson(response);
    assert.strictEqual(body.jsonrpc, '2.0');
    assert.ok(body.result?.protocolVersion);
  });
  // Capture session id for subsequent MCP calls (stateful Streamable HTTP).
  const sid = response.headers['mcp-session-id'];
  if (sid) exports.mcpSessionId = Array.isArray(sid) ? sid[0] : sid;
}}

###

# MCP — list available tools (no LLM required)
# @name mcpToolsList
POST {{baseUrl}}/mcp
Authorization: Bearer {{apiKey}}
Content-Type: application/json
Accept: application/json, text/event-stream
mcp-session-id: {{mcpSessionId}}

{
  "jsonrpc": "2.0",
  "id": 2,
  "method": "tools/list",
  "params": {}
}

{{
  const assert = require('assert');
  const mcpJson = (res) => {
    if (res.parsedBody && res.parsedBody.jsonrpc) return res.parsedBody;
    const raw = typeof res.body === 'string' ? res.body : (res.rawBody || '');
    const matches = String(raw).match(/^data:\s*(.+)$/gm);
    if (matches && matches.length) {
      return JSON.parse(matches[matches.length - 1].replace(/^data:\s*/, ''));
    }
    return res.parsedBody;
  };
  test('[smoke] status 200', () => assert.strictEqual(response.statusCode, 200));
  test('[TC-10] tools include query', () => {
    const tools = mcpJson(response).result?.tools;
    assert.ok(Array.isArray(tools));
    assert.ok(tools.some(t => t.name === 'query'));
  });
  test('[TC-12] tools include submit_feedback', () => {
    const tools = mcpJson(response).result?.tools;
    assert.ok(Array.isArray(tools));
    assert.ok(tools.some(t => t.name === 'submit_feedback'));
  });
}}

###

# MCP — submit feedback on earlier query answers (no LLM required)
# @name mcpSubmitFeedback
POST {{baseUrl}}/mcp
Authorization: Bearer {{apiKey}}
Content-Type: application/json
Accept: application/json, text/event-stream
mcp-session-id: {{mcpSessionId}}

{
  "jsonrpc": "2.0",
  "id": 4,
  "method": "tools/call",
  "params": {
    "name": "submit_feedback",
    "arguments": {
      "helped": "yes",
      "query": "integration smoke feedback",
      "notes": "httpyac contract test submission"
    }
  }
}

{{
  const assert = require('assert');
  const mcpJson = (res) => {
    if (res.parsedBody && res.parsedBody.jsonrpc) return res.parsedBody;
    const raw = typeof res.body === 'string' ? res.body : (res.rawBody || '');
    const matches = String(raw).match(/^data:\s*(.+)$/gm);
    if (matches && matches.length) {
      return JSON.parse(matches[matches.length - 1].replace(/^data:\s*/, ''));
    }
    return res.parsedBody;
  };
  test('[smoke] status 200', () => assert.strictEqual(response.statusCode, 200));
  test('[TC-13] submit_feedback call returns ok', () => {
    const content = mcpJson(response).result?.content;
    assert.ok(Array.isArray(content));
    const body = JSON.parse(content[0].text);
    assert.strictEqual(body.status, 'ok');
  });
}}

###

# MCP — call kb_read_facts directly (pure retrieval, no LLM)
# @name mcpCallReadFacts
POST {{baseUrl}}/mcp
Authorization: Bearer {{apiKey}}
Content-Type: application/json
Accept: application/json, text/event-stream
mcp-session-id: {{mcpSessionId}}

{
  "jsonrpc": "2.0",
  "id": 3,
  "method": "tools/call",
  "params": {
    "name": "kb_read_facts",
    "arguments": { "query": "authentication", "mode": "content", "includeContent": true }
  }
}

{{
  const assert = require('assert');
  const mcpJson = (res) => {
    if (res.parsedBody && res.parsedBody.jsonrpc) return res.parsedBody;
    const raw = typeof res.body === 'string' ? res.body : (res.rawBody || '');
    const matches = String(raw).match(/^data:\s*(.+)$/gm);
    if (matches && matches.length) {
      return JSON.parse(matches[matches.length - 1].replace(/^data:\s*/, ''));
    }
    return res.parsedBody;
  };
  test('[smoke] status 200', () => assert.strictEqual(response.statusCode, 200));
  test('[TC-11] tool returns content', () => assert.ok(Array.isArray(mcpJson(response).result?.content)));
}}
