# kb-slack configuration. With docker compose these are read from the repo-root .env
# (the same file the kb-server uses); this file documents the kb-slack-specific keys.

# From your Slack app — Basic Information → App Credentials.
SLACK_SIGNING_SECRET=

# From your Slack app — OAuth & Permissions → Bot User OAuth Token (starts with xoxb-).
SLACK_BOT_TOKEN=

# Where the kb-server is reachable. On the shared compose network this is the service name.
KB_SERVER_URL=http://kb-server:8080

# Bearer key for kb-server /v1/query — MUST match the server's KB_SERVER_API_KEY.
KB_SERVER_API_KEY=

# Port the bot listens on for Slack webhooks (container side).
PORT=3000

# Optional: override the Events API path (must match the Slack Request URL).
# SLACK_EVENTS_PATH=/slack/events
