{
  "name": "kb-slack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Slack bot that answers @kb mentions from a kb-server instance (Events API → /v1/query) and DMs via /v1/chat",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@slack/bolt": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.5.0"
  }
}
