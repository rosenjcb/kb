# Fly.io image for the build-to-serve chat demo (serving node AND hourly builder
# share one image; the Fly config selects the command + VM size).
#
#   * Serving node (fly.toml):        CMD below → scripts/fly/serve-entrypoint.sh
#   * Builder machine (fly.builder.toml): command override → scripts/fly/refresh.sh
#
# It is the monorepo Dockerfile plus (a) the AWS CLI for Tigris/S3 transport and
# (b) the scripts/fly orchestration. Kept at the repo root (not under packages/)
# so it stays infra/config — the compiled server it ships is unchanged.
#
# Build context is the repo root:  fly deploy  (config points here).
# Ops guide: FLY_ORCHESTRATION.md

FROM node:24-slim AS builder
ENV HUSKY=0
WORKDIR /app
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 make g++ git ca-certificates \
 && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm@9
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc .nvmrc ./
COPY scripts ./scripts
COPY packages/kb-core/package.json packages/kb-core/
COPY packages/kb-client/package.json packages/kb-client/
COPY packages/kb-server/package.json packages/kb-server/
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm run build

FROM node:24-slim AS runtime
ENV NODE_ENV=production \
    HUSKY=0 \
    PORT=38117 \
    KB_HOME=/data
WORKDIR /app
# git: builder cold-clone / incremental pull. curl+unzip+awscli: Tigris transport.
# bash/gawk/coreutils: the orchestration scripts. ca-certificates: TLS to S3.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      git ca-certificates curl unzip bash gawk \
 && curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-$(uname -m).zip" -o /tmp/awscliv2.zip \
 && unzip -q /tmp/awscliv2.zip -d /tmp \
 && /tmp/aws/install \
 && rm -rf /tmp/aws /tmp/awscliv2.zip \
 && apt-get purge -y unzip \
 && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/kb-client/dist ./packages/kb-client/dist
COPY --from=builder /app/packages/kb-server/dist ./packages/kb-server/dist
COPY --from=builder /app/packages/kb-core ./packages/kb-core
COPY --from=builder /app/packages/kb-core/node_modules ./packages/kb-core/node_modules
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/kb-server/package.json ./packages/kb-server/
COPY packages/kb-client/package.json ./packages/kb-client/
COPY packages/kb-core/package.json ./packages/kb-core/
COPY scripts/fly ./scripts/fly
RUN chmod +x ./scripts/fly/*.sh
ENV NODE_PATH=/app/packages/kb-core/node_modules:/app/node_modules
RUN mkdir -p /data
EXPOSE 38117
# Default command = serving node. The builder overrides it (see fly.builder.toml).
CMD ["bash", "/app/scripts/fly/serve-entrypoint.sh"]
