{
  "name": "kb-agent-harness",
  "version": "0.1.0",
  "description": "TypeScript-based agent harness with LLM provider abstraction",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "kb": "dist/bin/kb.js"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "dev:local": "node --env-file=.env.local --import tsx src/cli/index.ts",
    "start": "tsx src/cli/index.ts",
    "start:local": "node --env-file=.env.local --import tsx src/cli/index.ts",
    "build": "tsc && npm run build:cli",
    "build:cli": "node scripts/build-cli.mjs",
    "eval:kb-proper": "node scripts/eval-kb-proper.mjs",
    "eval:orchestrator-scenarios": "node scripts/eval-orchestrator-scenarios.mjs",
    "install:global": "npm run build && npm install -g .",
    "refresh:global": "npm run install:global",
    "which:kb": "command -v kb || where kb",
    "link:global": "npm run build && npm link",
    "unlink:global": "npm unlink -g kb-agent-harness",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:functional": "bash tests/functional-test.sh",
    "test:cli": "bash tests/cli-integration.sh",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "lint:fix:unsafe": "biome lint --write --unsafe .",
    "lint:fix:staged": "biome lint --write --staged --no-errors-on-unmatched .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "type-check": "tsc --noEmit",
    "precommit": "npm run lint:fix:staged && npm run type-check && npm run lint && npm run test",
    "prepare": "husky"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.1.3-alpha.12",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.6.0",
    "better-sqlite3": "^12.8.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "dayjs": "^1.11.13",
    "fast-glob": "^3.3.3",
    "ink": "^5.2.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "js-yaml": "^4.1.0",
    "react": "^18.3.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.39",
    "@types/react": "^18.3.28",
    "esbuild": "^0.25.0",
    "husky": "9.1.7",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.4"
  }
}
