{
  "name": "kb",
  "version": "0.1.0",
  "description": "TypeScript-based agent harness with LLM provider abstraction",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "kb": "dist/bin/kb"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "dev:local": "node --env-file=.env.local --import tsx src/cli/index.ts",
    "build": "tsc && node scripts/build-cli.mjs",
    "setup:category-clustering": "bash scripts/setup-category-clustering-env.sh",
    "install:global": "pnpm run build && pnpm rebuild better-sqlite3 && bash scripts/install-global.sh",
    "postinstall": "node scripts/postinstall-native.cjs",
    "eval:init": "node scripts/eval-run.mjs init",
    "eval:all": "node scripts/eval-run.mjs init",
    "eval:query": "node scripts/eval-run.mjs query",
    "eval:gen-doc": "node scripts/eval-gen-doc.mjs",
    "eval:trends": "node scripts/eval-trends.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:functional": "bash tests/functional-test.sh",
    "test:cli": "bash tests/cli-integration.sh",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write --unsafe .",
    "lint:fix:safe": "biome lint --write .",
    "lint:fix:staged": "biome lint --write --staged --no-errors-on-unmatched .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "type-check": "tsc --noEmit",
    "precommit": "npm run lint:fix:staged && npm run type-check && npm run lint && npm run test",
    "prepare": "husky"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.42.1",
    "@coderabbitai/ast-grep-langs": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.6.0",
    "better-sqlite3": "^12.9.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "dayjs": "^1.11.13",
    "diff": "^9.0.0",
    "fast-glob": "^3.3.3",
    "ink": "^5.2.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "js-yaml": "^4.1.0",
    "ora": "^8.2.0",
    "pricetoken": "^0.13.10",
    "react": "^18.3.1",
    "tree-sitter": "^0.25.0",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "ts-morph": "^28.0.0",
    "web-tree-sitter": "^0.26.8",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.28",
    "esbuild": "^0.25.0",
    "husky": "9.1.7",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.4"
  }
}
