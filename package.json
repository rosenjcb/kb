{
  "name": "kb",
  "version": "0.7.0",
  "description": "TypeScript-based agent harness with LLM provider abstraction",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "kb": "dist/bin/kb"
  },
  "scripts": {
    "preinstall": "node scripts/check-node-version.mjs",
    "dev": "tsx src/cli/index.ts",
    "dev:local": "node --env-file=.env.local --import tsx src/cli/index.ts",
    "build": "tsc && node scripts/build-cli.mjs",
    "install:global": "pnpm run build && bash scripts/install-global.sh",
    "uninstall:global": "bash scripts/uninstall-global.sh",
    "research:build": "cd research && latexmk -pdf -interaction=nonstopmode main.tex && echo '→ research/main.pdf'",
    "research:clean": "cd research && latexmk -C",
    "eval": "node scripts/eval-run.mjs",
    "moel": "node scripts/moel-run.mjs",
    "test": "NODE_OPTIONS=--no-warnings vitest run",
    "test:watch": "NODE_OPTIONS=--no-warnings vitest",
    "test:functional": "bash tests/functional-test.sh",
    "test:cli": "bash tests/cli-integration.sh",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write --unsafe .",
    "lint:fix:safe": "biome lint --write .",
    "lint:fix:staged": "biome lint --write --staged --no-errors-on-unmatched .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "type-check": "tsc --noEmit",
    "changeset": "node scripts/update-research-version.mjs",
    "release": "node scripts/publish.mjs",
    "precommit": "npm run lint:fix:staged && npm run type-check && npm run lint && npm run test",
    "prepare": "husky"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.42.1",
    "@coderabbitai/ast-grep-langs": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.6.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "dayjs": "^1.11.13",
    "diff": "^9.0.0",
    "fast-glob": "^3.3.3",
    "ink": "^5.2.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "js-yaml": "^4.1.0",
    "ora": "^8.2.0",
    "pricetoken": "^0.13.10",
    "react": "^18.3.1",
    "smol-toml": "^1.6.1",
    "tree-sitter-bash": "^0.25.1",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-c-sharp": "^0.23.5",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-css": "^0.25.0",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-html": "^0.23.2",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-scala": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "ts-morph": "^28.0.0",
    "web-tree-sitter": "^0.26.8",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.0",
    "@changesets/cli": "^2.31.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.28",
    "esbuild": "^0.25.0",
    "husky": "9.1.7",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.6"
  }
}
