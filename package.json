{
  "name": "kb-agent-harness",
  "version": "0.1.0",
  "description": "TypeScript-based agent harness with LLM provider abstraction",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "kb": "src/cli/index.ts"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "dev:local": "node --env-file=.env.local --import tsx src/cli/index.ts",
    "start": "tsx src/cli/index.ts",
    "start:local": "node --env-file=.env.local --import tsx src/cli/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint src business",
    "format": "biome format --write src business",
    "check": "biome check --write src business",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.6.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "js-yaml": "^4.1.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.4"
  }
}
