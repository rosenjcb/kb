{
  "name": "kb",
  "version": "0.1.0",
  "description": "TypeScript-based agent harness with LLM provider abstraction",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "kb": "dist/bin/kb"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "dev:local": "node --env-file=.env.local --import tsx src/cli/index.ts",
    "build": "tsc && node scripts/build-cli.mjs",
    "refresh:global": "pnpm run build && npm link",
    "eval:all": "node scripts/eval-run.mjs all",
    "eval:query": "node scripts/eval-run.mjs query",
    "eval:trends": "node scripts/eval-trends.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:functional": "bash tests/functional-test.sh",
    "test:cli": "bash tests/cli-integration.sh",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "lint:fix:unsafe": "biome lint --write --unsafe .",
    "lint:fix:staged": "biome lint --write --staged --no-errors-on-unmatched .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "type-check": "tsc --noEmit",
    "precommit": "npm run lint:fix:staged && npm run type-check && npm run lint && npm run test",
    "prepare": "husky"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.1.3-alpha.12",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.6.0",
    "better-sqlite3": "^12.8.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "dayjs": "^1.11.13",
    "fast-glob": "^3.3.3",
    "ink": "^5.2.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "js-yaml": "^4.1.0",
    "ora": "^8.2.0",
    "react": "^18.3.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.39",
    "@types/react": "^18.3.28",
    "esbuild": "^0.25.0",
    "husky": "9.1.7",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.4"
  }
}
