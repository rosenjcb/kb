# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Environment
.env
.env.local
.env.*.local
.envrc

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Sessions (transient)
sessions/*.json
sessions/namespaces/ci-*/
sessions/namespaces/test-*/

# Temporary output files
.tmp/
tmp/

# Node runtime
.node-gyp/

# Local Python clustering env
.kb-python/

# Skills directories (keep workflows + skills tracked)
.claude/**
!.claude/skills/
!.claude/skills/**
.cursor/**
!.cursor/skills/
!.cursor/skills/**
.github/**
!.github/SKILLS/
!.github/SKILLS/**
# Without these, `git add .github/workflows/<new>.yml` is refused by `.github/**`
# above — existing workflows keep working only because they are already tracked,
# so a NEW workflow silently never lands. The header says workflows are tracked;
# these make that true.
!.github/workflows/
!.github/workflows/**

# Misc
tickets/
# Accidental legacy path — do not recreate; harvest artifacts live in ~/.kb/evaluations/
evaluation/
.eval-logs/
.kb
