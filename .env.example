# Copy to .env for `docker compose up`. Do not commit your real .env.

# Base to serve (a name; built into the /data volume).
KB_BASE=demo

# Repos to boot-build a fresh base (comma-separated git URLs). Needed only on the
# first boot of an empty volume; can be cleared once the index is built.
KB_GIT_REPOS=https://github.com/sindresorhus/is

# Bearer key required for /v1/* and /mcp.
KB_SERVER_API_KEY=testkey

# Reindex cadence: 1h, 30m, 10s, or 0 to disable.
KB_REINDEX_INTERVAL=1h

# Provide exactly one LLM provider key (auto-detected).
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Host port to expose (container always listens on 8080).
PORT=8080
