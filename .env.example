# Copy to .env for the kb server, then run `pnpm run server:up` (or `pnpm run server:start`).
# `pnpm run server:up` seeds this file for you on first run. Do NOT commit your real .env.
# Full guide: packages/kb-server/README.md

# Base to serve (a name; built into the /data volume).
KB_BASE=demo

# Repos to boot-build a fresh base (comma-separated git URLs; each may carry an inline
# #branch). Needed only on the first boot of an empty volume; can be cleared once the
# index is built. For per-repo branches + ignore patterns, use a kb-server.json manifest
# instead (see packages/kb-server/README.md).
KB_GIT_REPOS=https://github.com/sindresorhus/is

# Optional for private GitHub repos: exported shell token forwarded into git clone/fetch
# inside the server process. Keep KB_GIT_REPOS as plain GitHub URLs; no need to embed
# credentials in each repo URL.
# GITHUB_TOKEN=
# GH_TOKEN=

# Bearer key required for /v1/* and /mcp. CHANGE THIS — do not ship "testkey".
# Comma-separated values are accepted (key rotation).
KB_SERVER_API_KEY=testkey

# Reindex cadence: 1h, 30m, 10s, or 0 to disable.
KB_REINDEX_INTERVAL=1h

# Provide exactly one LLM provider key (auto-detected) for answer synthesis.
GEMINI_API_KEY=
# Optional: point Gemini at a mock (integration tests set http://llm-mock:8080).
# GEMINI_API_BASE_URL=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Host port to expose (container always listens on 8080).
PORT=8080

# Structured log verbosity (debug | info | warn | error). Default: info.
# All log lines are JSON objects on stdout — parseable by Docker, Cloud Logging,
# Datadog, etc. Set to debug to see per-SSE-event and reindex-progress detail.
# LOG_LEVEL=info

# --- Slack integration (optional) -------------------------------------------
# Provide these to enable the built-in Slack webhook handler on the server.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
