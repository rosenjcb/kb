# Copy to .env for the kb server, then run `pnpm run server:up` (or `pnpm run server:start`).
# `pnpm run server:up` seeds this file for you on first run. Do NOT commit your real .env.
# Full guide: packages/kb-server/README.md

# Base to serve (a name; built into the /data volume).
KB_BASE=demo

# Repos to boot-build a fresh base (comma/whitespace-separated). Each entry is
# `url` or `url#branch`. The branch (or the remote's default HEAD when omitted)
# becomes that repo's primary branch on disk — Slack/chat Sources blob links use
# it later via discoverBaseRepos. There is no global KB_SOURCE_BRANCH.
# Multi-repo example:
#   KB_GIT_REPOS=https://github.com/acme/auth#main,https://github.com/acme/web#develop
# Needed only on the first boot of an empty volume; can be cleared once the index
# is built. New urls added later are cloned on the next boot the same way.
KB_GIT_REPOS=https://github.com/sindresorhus/is

# Optional: gitignore-style patterns to skip while indexing (comma/newline separated).
# Applied on the first build and every reindex.
# KB_SERVER_IGNORE=tests/, **/*.spec.ts, vendor

# Optional for private GitHub repos: exported shell token forwarded into git clone/fetch
# inside the server process. Keep KB_GIT_REPOS as plain GitHub URLs; no need to embed
# credentials in each repo URL.
# GITHUB_TOKEN=
# GH_TOKEN=

# Bearer key required for /v1/* and /mcp. CHANGE THIS — do not ship "testkey".
# Comma-separated values are accepted (key rotation).
KB_SERVER_API_KEY=testkey

# Browser origins allowed to call the API cross-origin (CORS). Needed for the
# hosted "try it" chat page (demo/) to reach this server. Comma-separated exact
# origins; a single "*" allows any origin. Empty = CORS disabled.
# Example: KB_SERVER_ALLOWED_ORIGINS=https://rosenjcb.github.io
# KB_SERVER_ALLOWED_ORIGINS=

# Reindex cadence: 1h, 30m, 10s, or 0 to disable.
KB_REINDEX_INTERVAL=1h

# Provide exactly one LLM provider key (auto-detected) for answer synthesis.
GEMINI_API_KEY=
# Optional: point Gemini at a mock (integration tests set http://llm-mock:8080).
# GEMINI_API_BASE_URL=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Host port to expose (container always listens on 38117).
PORT=38117

# Structured log verbosity (debug | info | warn | error). Default: info.
# All log lines are JSON objects on stdout — parseable by Docker, Cloud Logging,
# Datadog, etc. Set to debug to see per-SSE-event and reindex-progress detail.
# LOG_LEVEL=info

# --- Slack integration (optional) -------------------------------------------
# Set both secrets to mount POST /slack/events (signing HMAC + chat.postMessage).
# Sources footer blob links are per-repo from the volume clones (gitUrl + the
# primary branch established at clone time) — do not set KB_SOURCE_REPO_URL or
# KB_SOURCE_BRANCH (removed).
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# --- Client connection (the `kb` CLI/TUI) -----------------------------------
# These configure the CLIENT half — where `kb query` / `kb chat` / the TUI send
# requests. Not needed on the server. Precedence: KB_SERVER_URL > KBHOST/KBPORT >
# ~/.kb/config.json `server` block > localhost:38117. See kb-client/CLIENT.md.
# KB_SERVER_URL=http://localhost:38117
# KBHOST=localhost
# KBPORT=38117
# Bearer key the client sends; must match one of the server's KB_SERVER_API_KEY values.
# KB_SERVER_API_KEY=testkey
# Run indexing + retrieval in-process instead of over HTTP (eval / unit tests / offline dev).
# KB_LOCAL_MODE=false
